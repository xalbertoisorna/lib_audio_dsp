namespace lad;

stage lfo {
    // in/out signals
    input in_sample: int32[1];
    output out_sample: int32[1];
    // config parameters
    parameter fs : float32 = 48000.0, where ge: 1.0, le: 192000.0;
    parameter frequency : float32 = 0.0, where ge: 1.0, le: 100.0;
    parameter amplitude : float32 = 1.0, where ge: 0.0, le: 1.0;
    parameter phase_offset : float32 = 0.0, where ge: 0.0, le: 6.283185307179586; // 2 * pi
}
